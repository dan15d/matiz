# Copia este archivo como .env.local. Sin Supabase, la sala solo funciona entre pestañas del mismo
# navegador (para probar). Con Supabase, entre móviles: solo usa canales de Realtime, sin tablas,
# así que sirve el mismo proyecto que el Grimorio. La clave "anon" es pública por diseño.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
